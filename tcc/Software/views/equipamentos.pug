doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Equipamentos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    .container
      header.header
        h1 Lista de Equipamentos
        .header-actions
          a.btn-add(href="/adicionar?tipo=Equipamento") Adicionar equipamento
          a.btn-back(href="/inicio") Voltar para tela inicial

      main.table-container
        table
          thead
            tr
              th Número de Série
              th Tecnologia
              th Modelo
              th Locado
              th Ano de Aquisição
              th Status
              th ID
          tbody
            if equipamentos && equipamentos.length > 0
              each item in equipamentos
                tr
                  td= item.numeroSerie || "Não informado"
                  td= item.tecnologia || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.locado ? "Sim" : "Não"
                  td= item.anoAquisicao || "Não informado"
                  td= item.status || "Não informado"
                  td= item.id || "Não informado"
                  td
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td.empty-state(colspan="7") Nenhum equipamento encontrado no estoque.