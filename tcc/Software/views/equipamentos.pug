doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Equipamentos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.voltar-pagina(href="/inicio") Voltar
    .conteiner
      .metadados-pagina
        nav.migalhas-navegacao(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Equipamentos
        nav.navegacao-listas(aria-label="Outras áreas")
          a(href='/acessorios') Acessórios
          a(href='/veiculos') Veículos
          a(href='/clientes') Clientes
      header.cabecalho
        h1 Lista de Equipamentos
        .acoes-cabecalho
          a.botao-adicionar(href="/adicionar?tipo=Equipamento") Adicionar equipamento

      - var filtrosAtuais = filtros || {}
      - var tecnologiasLista = tecnologias && tecnologias.length ? tecnologias : ['2G', '4G']
      - var modelosLista = modelos && modelos.length ? modelos : ['RST - OBDII', 'RST - Mini LC', 'RST MINI - LC', 'RST Mini', 'RST LCv5', 'RST One', 'RST MÓVEL RF', 'RST ISCA GPS LORA', 'RST Plus', 'RST Híbrido', 'RST Micro', 'RST - Globalstar', 'NT40', 'NONOS-N4']

      form.filtros-lista(action='/equipamentos' method='get')
        .campo-busca
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Número de série, modelo ou tecnologia')
        button.alternador-filtros(type='button' aria-expanded='false' aria-controls='filtros-equipamentos') Filtrar
        .painel-filtros#filtros-equipamentos(hidden)
          strong Opções de filtragem
          label(for='tecnologia') Tecnologia
          select#tecnologia(name='tecnologia')
            option(value='') Todas
            each tecnologia in tecnologiasLista
              option(value=tecnologia selected=filtrosAtuais.tecnologia === tecnologia)= tecnologia
          label(for='modelo') Modelo
          select#modelo(name='modelo')
            option(value='') Todos
            each modelo in modelosLista
              option(value=modelo selected=filtrosAtuais.modelo === modelo)= modelo
          label(for='status') Status
          select#status(name='status')
            option(value='') Todos
            option(value='Locado' selected=filtrosAtuais.status === 'Locado') Locado
            option(value='Disponível' selected=filtrosAtuais.status === 'Disponível') Disponível
            option(value='Em Manutenção' selected=filtrosAtuais.status === 'Em Manutenção') Em Manutenção
          .acoes-filtros
            button.botao(type='submit') Aplicar filtros
            a.limpar-filtros(href='/equipamentos') Limpar

      main.conteiner-tabela
        table
          thead
            tr
              th Número de Série
              th Tecnologia
              th Modelo
              th Ano de Aquisição
              th Status
              th Veículo ligado
              th ID
              th Ações
          tbody
            if equipamentos && equipamentos.length > 0
              each item in equipamentos
                tr
                  td= item.numeroSerie || "Não informado"
                  td= item.tecnologia || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.anoAquisicao || "Não informado"
                  td
                    - var classeStatus = item.status === 'Locado' ? 'status-locado' : item.status === 'Disponível' ? 'status-disponivel' : item.status === 'Em Manutenção' ? 'status-manutencao' : 'status-desconhecido'
                    span.distintivo-status(class=classeStatus)= item.status || "Não informado"
                  td
                    if item.veiculoRelacionado
                      button.gatilho-relacao(type='button' data-titulo-relacao='Veículo ligado' data-relacao=JSON.stringify(item.relacao || {}) aria-label='Mostrar detalhes da relação com o veículo' title='Clique para ver os detalhes da relação') #{item.veiculoRelacionado.placa || 'Sem placa'} - #{item.veiculoRelacionado.marca || ''} #{item.veiculoRelacionado.modelo || ''}
                    else
                      | Não ligado
                  td= item.id || "Não informado"
                  td.acao-tabela
                    .botoes-acao
                      a.botao-editar(href='/objetos/' + item.id + '/editar?voltar=/equipamentos' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.formulario-remocao(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.botao-remover(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.estado-vazio(colspan="8") Nenhum equipamento encontrado no estoque.

      script(src='/javascripts/list-filters.js')
      script(src='/javascripts/relation-tooltip.js')