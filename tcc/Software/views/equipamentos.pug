doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Equipamentos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.page-back(href="/inicio") Voltar
    .container
      .page-meta
        nav.breadcrumbs(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Equipamentos
        nav.list-navigation(aria-label="Outras áreas")
          a(href='/acessorios') Acessórios
          a(href='/veiculos') Veículos
          a(href='/clientes') Clientes
      header.header
        h1 Lista de Equipamentos
        .header-actions
          a.btn-add(href="/adicionar?tipo=Equipamento") Adicionar equipamento

      - var filtrosAtuais = filtros || {}
      - var tecnologiasLista = tecnologias && tecnologias.length ? tecnologias : ['2G', '4G']
      - var modelosLista = modelos && modelos.length ? modelos : ['RST - OBDII', 'RST - Mini LC', 'RST MINI - LC', 'RST Mini', 'RST LCv5', 'RST One', 'RST MÓVEL RF', 'RST ISCA GPS LORA', 'RST Plus', 'RST Híbrido', 'RST Micro', 'RST - Globalstar', 'NT40', 'NONOS-N4']

      form.list-filters(action='/equipamentos' method='get')
        .search-field
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Número de série, modelo ou tecnologia')
        button.filter-toggle(type='button' aria-expanded='false' aria-controls='filtros-equipamentos') Filtrar
        .filter-panel#filtros-equipamentos(hidden)
          strong Opções de filtragem
          label(for='tecnologia') Tecnologia
          select#tecnologia(name='tecnologia')
            option(value='') Todas
            each tecnologia in tecnologiasLista
              option(value=tecnologia selected=filtrosAtuais.tecnologia === tecnologia)= tecnologia
          label(for='modelo') Modelo
          select#modelo(name='modelo')
            option(value='') Todos
            each modelo in modelosLista
              option(value=modelo selected=filtrosAtuais.modelo === modelo)= modelo
          label(for='status') Status
          select#status(name='status')
            option(value='') Todos
            option(value='Locado' selected=filtrosAtuais.status === 'Locado') Locado
            option(value='Disponível' selected=filtrosAtuais.status === 'Disponível') Disponível
            option(value='Em Manutenção' selected=filtrosAtuais.status === 'Em Manutenção') Em Manutenção
          .filter-actions
            button.btn(type='submit') Aplicar filtros
            a.clear-filters(href='/equipamentos') Limpar

      main.table-container
        table
          thead
            tr
              th Número de Série
              th Tecnologia
              th Modelo
              th Ano de Aquisição
              th Status
              th Veículo ligado
              th ID
              th Ações
          tbody
            if equipamentos && equipamentos.length > 0
              each item in equipamentos
                tr
                  td= item.numeroSerie || "Não informado"
                  td= item.tecnologia || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.anoAquisicao || "Não informado"
                  td
                    - var classeStatus = item.status === 'Locado' ? 'status-located' : item.status === 'Disponível' ? 'status-available' : item.status === 'Em Manutenção' ? 'status-maintenance' : 'status-unknown'
                    span.status-badge(class=classeStatus)= item.status || "Não informado"
                  td
                    if item.veiculoRelacionado
                      button.relation-trigger(type='button' data-relation-title='Veículo ligado' data-relation=JSON.stringify(item.relacao || {}) aria-label='Mostrar detalhes da relação com o veículo' title='Clique para ver os detalhes da relação') #{item.veiculoRelacionado.placa || 'Sem placa'} - #{item.veiculoRelacionado.marca || ''} #{item.veiculoRelacionado.modelo || ''}
                    else
                      | Não ligado
                  td= item.id || "Não informado"
                  td.table-action
                    .action-buttons
                      a.btn-edit(href='/objetos/' + item.id + '/editar?voltar=/equipamentos' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.delete-form(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.btn-delete(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.empty-state(colspan="8") Nenhum equipamento encontrado no estoque.

      script(src='/javascripts/list-filters.js')
      script(src='/javascripts/relation-tooltip.js')