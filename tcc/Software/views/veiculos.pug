doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Veículos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.page-back(href="/inicio") Voltar
    .container
      .page-meta
        nav.breadcrumbs(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Veículos
        nav.list-navigation(aria-label="Outras áreas")
          a(href='/equipamentos') Equipamentos
          a(href='/acessorios') Acessórios
          a(href='/clientes') Clientes
      header.header
        h1 Lista de Veículos
        .header-actions
          a.btn-add(href="/adicionar?tipo=Veículo") Adicionar veículo

      - var filtrosAtuais = filtros || {}

      form.list-filters(action='/veiculos' method='get')
        .search-field
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Marca, modelo ou placa')
        button.filter-toggle(type='button' aria-expanded='false' aria-controls='filtros-veiculos') Filtrar
        .filter-panel#filtros-veiculos(hidden)
          strong Opções de filtragem
          label(for='ano') Ano
          input#ano(type='number' name='ano' value=filtrosAtuais.ano placeholder='Ex.: 2024' min='1900' max='2100')
          .filter-actions
            button.btn(type='submit') Aplicar filtros
            a.clear-filters(href='/veiculos') Limpar

      main.table-container
        table
          thead
            tr
              th Placa
              th Marca
              th Modelo
              th Ano
              th ID
              th Ações
          tbody
            if veiculos && veiculos.length > 0
              each item in veiculos
                tr
                  td= item.placa || "Não informado"
                  td= item.marca || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.ano || "Não informado"
                  td= item.id || "Não informado"
                  td.table-action
                    .action-buttons
                      a.btn-edit(href='/objetos/' + item.id + '/editar?voltar=/veiculos' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.delete-form(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.btn-delete(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.empty-state(colspan="6") Nenhum veículo encontrado no estoque.

      script(src='/javascripts/list-filters.js')