doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Veículos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.page-back(href="/inicio") Voltar
    .container
      nav.breadcrumbs(aria-label="Navegação estrutural")
        a(href="/inicio") Início
        span(aria-hidden="true") /
        span Veículos
      header.header
        h1 Lista de Veículos
        .header-actions
          a.btn-add(href="/adicionar?tipo=Veículo") Adicionar veículo

      main.table-container
        table
          thead
            tr
              th Marca
              th Modelo
              th Ano
              th Placa
              th ID
              th Ações
          tbody
            if veiculos && veiculos.length > 0
              each item in veiculos
                tr
                  td= item.marca || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.ano || "Não informado"
                  td= item.placa || "Não informado"
                  td= item.id || "Não informado"
                  td.table-action
                    form.delete-form(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                      button.btn-delete(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.empty-state(colspan="6") Nenhum veículo encontrado no estoque.