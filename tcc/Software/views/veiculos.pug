doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Veículos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    .container
      header.header
        h1 Lista de Veículos
        .header-actions
          a.btn-add(href="/adicionar?tipo=Veículo") Adicionar veículo
          a.btn-back(href="/inicio") Voltar para tela inicial

      main.table-container
        table
          thead
            tr
              th Marca
              th Modelo
              th Ano
              th Placa
              th ID
          tbody
            if veiculos && veiculos.length > 0
              each item in veiculos
                tr
                  td= item.marca || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.ano || "Não informado"
                  td= item.placa || "Não informado"
                  td= item.id || "Não informado"
                  td
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td.empty-state(colspan="5") Nenhum veículo encontrado no estoque.