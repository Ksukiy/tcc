doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Veículos
    style.
      * { box-sizing: border-box; }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7f6;
        margin: 0;
        padding: 40px 20px;
        color: #333;
      }
      .container { max-width: 900px; margin: 0 auto; }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
      }
      .header h1 { margin: 0; color: #2c3e50; }
      .btn-back {
        background-color: #7f8c8d;
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 5px;
        font-weight: bold;
        transition: background 0.2s;
      }
      .btn-back:hover { background-color: #95a5a6; }
      
      /* Estilos da Tabela */
      .table-container {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }
      th, td {
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
      }
      th {
        background-color: #2c3e50;
        color: #fff;
        font-weight: 600;
      }
      tr:last-child td { border-bottom: none; }
      tr:nth-child(even) { background-color: #f9f9f9; }
      
      /* Badges de Status */
      .badge {
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: bold;
        text-transform: uppercase;
      }
      .badge-active { background-color: #e5f9e7; color: #1e7e34; }
      .badge-inactive { background-color: #fce8e6; color: #bd2130; }
  
  body
    .container
      header.header
        h1 Lista de Veículos
        a.btn-back(href="/") Voltar para Home
      
      main.table-container
        table
          thead
            tr
              th Nome/Modelo
              th Número de Série
              th Ativo
          tbody
            //- Loop condicional para renderizar as linhas dinamicamente
            if veiculos && veiculos.length > 0
              each item in veiculos
                tr
                  td= item.nome || "Não informado"
                  td= item.numeroSerie
                  td
                    //- Se item.ativo for true mostra "Sim" com classe verde, se for false mostra "Não" com classe vermelha
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td(colspan="3" style="text-align: center; color: #7f8c8d;") Nenhum veículo encontrado no estoque.