doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Veículos
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.voltar-pagina(href="/inicio") Voltar
    .conteiner
      .metadados-pagina
        nav.migalhas-navegacao(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Veículos
        nav.navegacao-listas(aria-label="Outras áreas")
          a(href='/equipamentos') Equipamentos
          a(href='/acessorios') Acessórios
          a(href='/clientes') Clientes
      header.cabecalho
        h1 Lista de Veículos
        .acoes-cabecalho
          a.botao-adicionar(href="/adicionar?tipo=Veículo") Adicionar veículo

      - var filtrosAtuais = filtros || {}
      - var marcasLista = marcas && marcas.length ? marcas : []
      - var modelosLista = modelos && modelos.length ? modelos : []

      form.filtros-lista(action='/veiculos' method='get')
        .campo-busca
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Marca, modelo ou placa')
        button.alternador-filtros(type='button' aria-expanded='false' aria-controls='filtros-veiculos') Filtrar
        .painel-filtros#filtros-veiculos(hidden)
          strong Opções de filtragem
          label(for='marca') Marca
          select#marca(name='marca')
            option(value='') Todas
            each marca in marcasLista
              option(value=marca selected=filtrosAtuais.marca === marca)= marca
          label(for='modelo') Modelo
          select#modelo(name='modelo')
            option(value='') Todos
            each modelo in modelosLista
              option(value=modelo selected=filtrosAtuais.modelo === modelo)= modelo
          label(for='ano') Ano
          input#ano(type='number' name='ano' value=filtrosAtuais.ano placeholder='Ex.: 2024' min='1900' max='2100')
          .acoes-filtros
            button.botao(type='submit') Aplicar filtros
            a.limpar-filtros(href='/veiculos') Limpar

      main.conteiner-tabela
        table
          thead
            tr
              th Placa
              th Marca
              th Modelo
              th Ano
              th Equipamento ligado
              th ID
              th Ações
          tbody
            if veiculos && veiculos.length > 0
              each item in veiculos
                tr
                  td= item.placa || "Não informado"
                  td= item.marca || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.ano || "Não informado"
                  td
                    if item.equipamentoRelacionado
                      button.gatilho-relacao(type='button' data-titulo-relacao='Equipamento ligado' data-relacao=JSON.stringify(item.relacao || {}) aria-label='Mostrar detalhes da relação com o equipamento' title='Clique para ver os detalhes da relação') #{item.equipamentoRelacionado.numeroSerie || 'Sem número de série'} - #{item.equipamentoRelacionado.modelo || ''}
                    else
                      | Não ligado
                  td= item.id || "Não informado"
                  td.acao-tabela
                    .botoes-acao
                      a.botao-editar(href='/objetos/' + item.id + '/editar?voltar=/veiculos' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.formulario-remocao(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.botao-remover(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.estado-vazio(colspan="7") Nenhum veículo encontrado no estoque.

      script(src='/javascripts/list-filters.js')
      script(src='/javascripts/relation-tooltip.js')