label#gatilho-menu.gatilho-menu(for="alternador-menu" aria-label="Abrir menu")
  span
  span
  span

aside.menu-lateral
  .topo-menu-lateral
    p.rotulo-menu-lateral PAINEL
  .cartao-usuario
    .avatar-usuario= (nome || usuario || 'U').charAt(0).toUpperCase()
    .texto-cartao-usuario
      span Usuário conectado
      strong= nome || usuario || 'Visitante'
