    button#abrir-menu-opcoes.botao-menu-opcoes(type="button")
      span.icone-navegacao ⚙
      | Gerenciar entradas

dialog#dialogo-opcoes.dialogo-opcoes
  .conteudo-dialogo-opcoes
    button.fechar-dialogo-opcoes(type="button" aria-label="Fechar") ×
    p.rotulo-menu-lateral CATÁLOGO
    h2 Gerenciar entradas
    p.dica-dialogo-opcoes Adicione, renomeie ou remova as entradas usadas nos cadastros.
    #grupos-opcoes.colunas-dialogo-opcoes
    p#mensagem-opcoes.mensagem-opcoes(role="status" hidden)

script.
  (function () {
    const menuToggle = document.getElementById('alternador-menu');
    const sideMenu = document.querySelector('.menu-lateral');
    const menuTrigger = document.getElementById('gatilho-menu');

    menuTrigger.addEventListener('click', function (event) {
      event.preventDefault();
      menuToggle.checked = !menuToggle.checked;
      sideMenu.classList.toggle('dispensado', !menuToggle.checked);
    });

    var dialog = document.getElementById('dialogo-opcoes');
    var optionsButton = document.getElementById('abrir-menu-opcoes');
    var closeButton = dialog.querySelector('.fechar-dialogo-opcoes');
    var message = document.getElementById('mensagem-opcoes');

    function showMessage(text, isError) {
      message.textContent = text;
      message.classList.toggle('erro', Boolean(isError));
      message.hidden = false;
    }

    function renderOptions(data) {
      var groups = document.getElementById('grupos-opcoes');
      groups.innerHTML = '';
      Object.keys(data).forEach(function (campo) {
        var group = document.createElement('section');
        var heading = document.createElement('h3');
        var addForm = document.createElement('form');
        var input = document.createElement('input');
        var addButton = document.createElement('button');
        var list = document.createElement('ul');
        group.className = 'grupo-opcoes';
        group.dataset.campo = campo;
        heading.textContent = campo.indexOf('modeloAcessorio:') === 0
          ? 'Modelos - ' + campo.slice('modeloAcessorio:'.length)
          : campo === 'tipoAcessorio' ? 'Tipos de acessórios'
          : campo === 'modelo' ? 'Modelos de equipamentos'
          : campo === 'marca' ? 'Veículos'
          : campo === 'tipoCliente' ? 'Tipos de clientes'
          : 'Tecnologias';
        addForm.className = 'formulario-adicionar-opcao';
        input.type = 'text';
        input.name = 'valor';
        input.placeholder = 'Nova entrada';
        input.required = true;
        addButton.type = 'submit';
        addButton.className = 'botao';
        addButton.textContent = 'Adicionar';
        list.className = 'lista-opcoes';
        addForm.appendChild(input);
        addForm.appendChild(addButton);
        group.appendChild(heading);
        group.appendChild(addForm);
        group.appendChild(list);
        groups.appendChild(group);
        list = group.querySelector('.lista-opcoes');
        (data[campo] || []).forEach(function (valor) {
          var item = document.createElement('li');
          var label = document.createElement('span');
          var edit = document.createElement('button');
          var remove = document.createElement('button');
          label.textContent = valor;
          edit.type = 'button';
          edit.textContent = 'Editar';
          remove.type = 'button';
          remove.textContent = 'Remover';
          edit.addEventListener('click', function () {
            var novo = window.prompt('Novo valor para "' + valor + '":', valor);
            if (novo && novo.trim() !== valor) {
              updateOption('editar', campo, valor, novo.trim());
            }
          });
          remove.addEventListener('click', function () {
            if (window.confirm('Remover "' + valor + '"?')) {
              updateOption('remover', campo, valor, '');
            }
          });
          item.appendChild(label);
          item.appendChild(edit);
          item.appendChild(remove);
          list.appendChild(item);
        });
      });
      groups.querySelectorAll('.formulario-adicionar-opcao').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var campo = form.closest('.grupo-opcoes').dataset.campo;
          var valor = form.elements.valor.value.trim();
          if (valor) {
            updateOption('adicionar', campo, '', valor);
            form.reset();
          }
        });
      });
    }

    function updateOption(operacao, campo, atual, valor) {
      fetch('/opcoes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ operacao: operacao, campo: campo, atual: atual, valor: valor })
      }).then(function (response) {
        return response.json().then(function (data) {
          if (!response.ok) throw new Error(data.message || 'Não foi possível atualizar as opções.');
          return data;
        });
      }).then(function (data) {
        renderOptions(data);
        showMessage('Opções atualizadas.');
      }).catch(function (erro) {
        showMessage(erro.message, true);
      });
    }

    optionsButton.addEventListener('click', function () {
      fetch('/opcoes').then(function (response) { return response.json(); }).then(function (data) {
        renderOptions(data);
        message.hidden = true;
        dialog.showModal();
      }).catch(function () {
        showMessage('Não foi possível carregar as opções.', true);
        dialog.showModal();
      });
    });
    closeButton.addEventListener('click', function () { dialog.close(); });
  }());
