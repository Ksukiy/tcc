extends layout

block content
	.login-wrapper
		.login-brand
			img(src='/images/LogoEmp6-Photoroom.png' alt='Soluções em Rastreamento Veicular')
		.login-box
			h1 Boas Vindas
			if message
				p.error= message
			form.login-form(action='/login' method='post')
				label(for='email') E-mail
				input#email(type='email' name='email' placeholder='exemplo@exemplo.com' required)

				label(for='password') Senha
				input#password(type='password' name='password' placeholder='123456' required)

				.form-row
					label.remember
						input(type='checkbox' name='remember')
						| Lembrar de mim

				.form-actions
					button.btn#submit(type='submit') Entrar

				.form-actions
					a.cancel(href='/cadastro') Cadastrar Novo Usuário
