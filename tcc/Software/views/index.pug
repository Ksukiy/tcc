doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Hermes
    link(rel='stylesheet', href='/stylesheets/style.css')

  body.corpo-inicio
    include menu.pug

    main.estrutura-inicio
      header.cabecalho-inicio
        .marca-cabecalho-inicio
          img(src='/images/LogoEmp7.png' alt='Logo Hermes')
        .texto-cabecalho-inicio
          h1 Hermes - Gerenciador de Estoque
          p Escolha uma área para continuar.

      main.grade-resumo
        a.botao-categoria.cartao-equipamentos(href="/equipamentos")
          span.imagem-cartao(aria-hidden="true")
          span.titulo-cartao Equipamentos
            span.seta-cartao ↗

        a.botao-categoria.cartao-acessorios(href="/acessorios")
          span.imagem-cartao(aria-hidden="true")
          span.titulo-cartao Acessórios
            span.seta-cartao ↗

        a.botao-categoria.cartao-veiculos(href="/veiculos")
          span.imagem-cartao(aria-hidden="true")
          span.titulo-cartao Veículos
            span.seta-cartao ↗

        a.botao-categoria.cartao-clientes(href="/clientes")
          span.imagem-cartao(aria-hidden="true")
          span.titulo-cartao Clientes
            span.seta-cartao ↗

      section.painel-inicio(aria-labelledby="titulo-resumo")
        - var resumoAtual = resumo || {}
        .cabecalho-resumo
          .texto-cabecalho-resumo
            p.chamada-resumo RESUMO DO SISTEMA
            h2#titulo-resumo Visão rápida

        .estatisticas-resumo
          .estatistica-resumo
            span.icone-estatistica-resumo ◈
            strong= resumoAtual.equipamentos || 0
            span Equipamentos cadastrados
          .estatistica-resumo
            span.icone-estatistica-resumo ◈
            strong= resumoAtual.acessorios || 0
            span Acessórios cadastrados
          .estatistica-resumo
            span.icone-estatistica-resumo ◈
            strong= resumoAtual.veiculos || 0
            span Veículos cadastrados
          .estatistica-resumo
            span.icone-estatistica-resumo ◈
            strong= resumoAtual.clientes || 0
            span Clientes cadastrados

        .links-resumo
          a.botao-adicionar-resumo(href="/adicionar") Adicionar
