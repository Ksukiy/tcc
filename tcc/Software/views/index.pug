doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Hermes
    link(rel='stylesheet', href='/stylesheets/style.css')

  body.home-body
    include menu.pug

    main.home-shell
      header.home-header
        .home-header__brand
          img(src='/images/LogoEmp7.png' alt='Logo Hermes')
        .home-header__copy
          h1 Hermes - Gerenciador de Estoque
          p Escolha uma área para continuar.

      main.dashboard-grid
        a.btn-category.card-equipment(href="/equipamentos")
          span.card-image(aria-hidden="true")
          span.card-title Equipamentos
            span.card-arrow ↗

        a.btn-category.card-accessories(href="/acessorios")
          span.card-image(aria-hidden="true")
          span.card-title Acessórios
            span.card-arrow ↗

        a.btn-category.card-vehicles(href="/veiculos")
          span.card-image(aria-hidden="true")
          span.card-title Veículos
            span.card-arrow ↗

        a.btn-category.card-clients(href="/clientes")
          span.card-image(aria-hidden="true")
          span.card-title Clientes
            span.card-arrow ↗

      section.home-dashboard(aria-labelledby="dashboard-title")
        - var resumoAtual = resumo || {}
        .dashboard-heading
          .dashboard-heading__copy
            p.dashboard-kicker RESUMO DO SISTEMA
            h2#dashboard-title Visão rápida
          span.dashboard-date Painel principal

        .dashboard-stats
          .dashboard-stat
            span.dashboard-stat__icon ◈
            strong= resumoAtual.equipamentos || 0
            span Equipamentos cadastrados
          .dashboard-stat
            span.dashboard-stat__icon ◈
            strong= resumoAtual.acessorios || 0
            span Acessórios cadastrados
          .dashboard-stat
            span.dashboard-stat__icon ◈
            strong= resumoAtual.veiculos || 0
            span Veículos cadastrados
          .dashboard-stat
            span.dashboard-stat__icon ◈
            strong= resumoAtual.clientes || 0
            span Clientes cadastrados

        .dashboard-links
          a.dashboard-add-button(href="/adicionar") Adicionar
