extends layout

block content
  .login-wrapper
    .login-brand
      img(src='/images/LogoEmp6-Photoroom.png' alt='Soluções em Rastreamento Veicular')
    .login-box
      h1 Cadastro
      if message
        p.error= message
      form.login-form(action='/cadastro' method='post')
        label(for='nome') Nome
        input#nome(type='text' name='nome' placeholder='Seu nome completo' required)

        label(for='email') E-mail
        input#email(type='email' name='email' placeholder='exemplo@exemplo.com' required)

        label(for='senha') Senha
        .password-field
          input#senha(type='password' name='senha' placeholder='Sua senha' required)
          button.password-toggle(type='button' aria-label='Mostrar senha' aria-pressed='false')
            svg.password-toggle__icon.password-toggle__icon--visible(viewBox='0 0 24 24' aria-hidden='true' focusable='false')
              path(d='M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z')
              circle(cx='12' cy='12' r='2.5')
            svg.password-toggle__icon.password-toggle__icon--hidden(viewBox='0 0 24 24' aria-hidden='true' focusable='false')
              path(d='m3 3 18 18')
              path(d='M10.6 6.2A10.7 10.7 0 0 1 12 6c6.5 0 10 6 10 6a17.5 17.5 0 0 1-3.1 3.8M6.7 6.7C3.6 8.5 2 12 2 12s3.5 6 10 6c1.6 0 3-.4 4.2-.9')
              path(d='M9.9 9.9a3 3 0 0 0 4.2 4.2')

        .form-actions
          button.btn(type='submit') Cadastrar
          a.cancel(href='/login') Voltar para login
