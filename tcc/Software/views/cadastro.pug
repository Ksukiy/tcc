extends layout

block content
  .login-wrapper
    .login-brand
      img(src='/images/LogoEmp6-Photoroom.png' alt='Soluções em Rastreamento Veicular')
    .login-box
      h1 Cadastro
      if message
        p.error= message
      form.login-form(action='/cadastro' method='post')
        label(for='nome') Nome
        input#nome(type='text' name='nome' placeholder='Seu nome completo' required)

        label(for='email') E-mail
        input#email(type='email' name='email' placeholder='exemplo@exemplo.com' required)

        label(for='senha') Senha
        input#senha(type='password' name='senha' placeholder='Sua senha' required)

        .form-actions
          button.btn(type='submit') Cadastrar
          a.cancel(href='/login') Voltar para login
