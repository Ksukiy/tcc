doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Clientes
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    .container
      header.header
        h1 Lista de Clientes
        .header-actions
          a.btn-add(href="/adicionar?tipo=Cliente") Adicionar cliente
          a.btn-back(href="/inicio") Voltar para tela inicial

      main.table-container
        table
          thead
            tr
              th Nome
              th Fone
              th Tipo de Cliente
              th Cpf/Cnpj
              th ID
              th Status
          tbody
            if clientes && clientes.length > 0
              each item in clientes
                tr
                  td= item.nome || "Não informado"
                  td= item.fone || "Não informado"
                  td= item.tipoCliente || "Não informado"
                  td= item.cpfCnpj || "Não informado"
                  td= item.id || "Não informado"
                  td
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td.empty-state(colspan="6") Nenhum cliente encontrado.