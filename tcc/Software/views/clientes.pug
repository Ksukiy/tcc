doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Clientes
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.voltar-pagina(href="/inicio") Voltar
    .conteiner
      .metadados-pagina
        nav.migalhas-navegacao(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Clientes
        nav.navegacao-listas(aria-label="Outras áreas")
          a(href='/equipamentos') Equipamentos
          a(href='/acessorios') Acessórios
          a(href='/veiculos') Veículos
      header.cabecalho
        h1 Lista de Clientes
        .acoes-cabecalho
          a.botao-adicionar(href="/adicionar?tipo=Cliente") Adicionar cliente

      - var filtrosAtuais = filtros || {}
      - var tiposClienteLista = tiposCliente && tiposCliente.length ? tiposCliente : []

      form.filtros-lista(action='/clientes' method='get')
        .campo-busca
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Nome, telefone ou CPF/CNPJ')
        button.alternador-filtros(type='button' aria-expanded='false' aria-controls='filtros-clientes') Filtrar
        .painel-filtros#filtros-clientes(hidden)
          strong Opções de filtragem
          label(for='tipoCliente') Tipo de cliente
          select#tipoCliente(name='tipoCliente')
            option(value='') Todos
            each tipoCliente in tiposClienteLista
              option(value=tipoCliente selected=filtrosAtuais.tipoCliente === tipoCliente)= tipoCliente
          .acoes-filtros
            button.botao(type='submit') Aplicar filtros
            a.limpar-filtros(href='/clientes') Limpar

      main.conteiner-tabela
        table
          thead
            tr
              th Nome
              th Fone
              th Tipo de Cliente
              th Cpf/Cnpj
              th ID
              th Ações
          tbody
            if clientes && clientes.length > 0
              each item in clientes
                tr
                  td= item.nome || "Não informado"
                  td= item.fone || "Não informado"
                  td= item.tipoCliente || "Não informado"
                  td= item.cpfCnpj || "Não informado"
                  td= item.id || "Não informado"
                  td.acao-tabela
                    .botoes-acao
                      a.botao-editar(href='/objetos/' + item.id + '/editar?voltar=/clientes' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.formulario-remocao(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.botao-remover(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.estado-vazio(colspan="6") Nenhum cliente encontrado.

      script(src='/javascripts/list-filters.js')