doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Acessórios
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.page-back(href="/inicio") Voltar
    .container
      nav.breadcrumbs(aria-label="Navegação estrutural")
        a(href="/inicio") Início
        span(aria-hidden="true") /
        span Acessórios
      header.header
        h1 Lista de Acessórios
        .header-actions
          a.btn-add(href="/adicionar?tipo=Acessório") Adicionar acessório

      main.table-container
        table
          thead
            tr
              th Tipo
              th Modelo
              th Locado
              th Status
              th ID
              th Ações
          tbody
            if acessorios && acessorios.length > 0
              each item in acessorios
                tr
                  td= item.tipo || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.locado ? "Sim" : "Não"
                  td= item.status || "Não informado"
                  td= item.id || "Não informado"
                  td.table-action
                    form.delete-form(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                      button.btn-delete(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.empty-state(colspan="6") Nenhum acessório encontrado no estoque.