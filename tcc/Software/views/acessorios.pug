doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Acessórios
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    .container
      header.header
        h1 Lista de Acessórios
        a.btn-back(href="/") Voltar para Home

      main.table-container
        table
          thead
            tr
              th Nome/Modelo
              th Número de Série
              th Ativo
          tbody
            if acessorios && acessorios.length > 0
              each item in acessorios
                tr
                  td= item.nome || "Não informado"
                  td= item.numeroSerie
                  td
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td.empty-state(colspan="3") Nenhum acessório encontrado no estoque.