doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Acessórios
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.page-back(href="/inicio") Voltar
    .container
      .page-meta
        nav.breadcrumbs(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Acessórios
        nav.list-navigation(aria-label="Outras áreas")
          a(href='/equipamentos') Equipamentos
          a(href='/veiculos') Veículos
          a(href='/clientes') Clientes
      header.header
        h1 Lista de Acessórios
        .header-actions
          a.btn-add(href="/adicionar?tipo=Acessório") Adicionar acessório

      - var filtrosAtuais = filtros || {}
      - var tiposAcessorioLista = tiposAcessorio && tiposAcessorio.length ? tiposAcessorio : ['Bloqueador', 'Leitor', 'Chaveiro']
      - var modelosLista = modelos && modelos.length ? modelos : ['Relé de Bloqueio', 'Ibutton']

      form.list-filters(action='/acessorios' method='get')
        .search-field
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Tipo, modelo ou status')
        button.filter-toggle(type='button' aria-expanded='false' aria-controls='filtros-acessorios') Filtrar
        .filter-panel#filtros-acessorios(hidden)
          strong Opções de filtragem
          label(for='tipoAcessorio') Tipo de acessório
          select#tipoAcessorio(name='tipoAcessorio')
            option(value='') Todos
            each tipoAcessorio in tiposAcessorioLista
              option(value=tipoAcessorio selected=filtrosAtuais.tipoAcessorio === tipoAcessorio)= tipoAcessorio
          label(for='modelo') Modelo
          select#modelo(name='modelo')
            option(value='') Todos
            each modelo in modelosLista
              option(value=modelo selected=filtrosAtuais.modelo === modelo)= modelo
          label(for='status') Status
          select#status(name='status')
            option(value='') Todos
            option(value='Locado' selected=filtrosAtuais.status === 'Locado') Locado
            option(value='Disponível' selected=filtrosAtuais.status === 'Disponível') Disponível
            option(value='Em Manutenção' selected=filtrosAtuais.status === 'Em Manutenção') Em Manutenção
          .filter-actions
            button.btn(type='submit') Aplicar filtros
            a.clear-filters(href='/acessorios') Limpar

      main.table-container
        table
          thead
            tr
              th Tipo
              th Modelo
              th Status
              th ID
              th Ações
          tbody
            if acessorios && acessorios.length > 0
              each item in acessorios
                tr
                  td= item.tipoAcessorio || "Não informado"
                  td= item.modelo || "Não informado"
                  td
                    - var classeStatus = item.status === 'Locado' ? 'status-located' : item.status === 'Disponível' ? 'status-available' : item.status === 'Em Manutenção' ? 'status-maintenance' : 'status-unknown'
                    span.status-badge(class=classeStatus)= item.status || "Não informado"
                  td= item.id || "Não informado"
                  td.table-action
                    .action-buttons
                      a.btn-edit(href='/objetos/' + item.id + '/editar?voltar=/acessorios' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.delete-form(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.btn-delete(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.empty-state(colspan="5") Nenhum acessório encontrado no estoque.

      script(src='/javascripts/list-filters.js')