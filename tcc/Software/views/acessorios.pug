doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Acessórios
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    .container
      header.header
        h1 Lista de Acessórios
        .header-actions
          a.btn-add(href="/adicionar?tipo=Acessório") Adicionar acessório
          a.btn-back(href="/inicio") Voltar para tela inicial

      main.table-container
        table
          thead
            tr
              th Tipo
              th Modelo
              th Locado
              th Status
              th ID
          tbody
            if acessorios && acessorios.length > 0
              each item in acessorios
                tr
                  td= item.tipo || "Não informado"
                  td= item.modelo || "Não informado"
                  td= item.locado ? "Sim" : "Não"
                  td= item.status || "Não informado"
                  td= item.id || "Não informado"
                  td
                    if item.ativo
                      span.badge.badge-active Sim
                    else
                      span.badge.badge-inactive Não
            else
              tr
                td.empty-state(colspan="5") Nenhum acessório encontrado no estoque.