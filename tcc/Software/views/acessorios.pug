doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Estoque - Acessórios
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    include menu.pug
    a.voltar-pagina(href="/inicio") Voltar
    .conteiner
      .metadados-pagina
        nav.migalhas-navegacao(aria-label="Navegação estrutural")
          a(href="/inicio") Início
          span(aria-hidden="true") /
          span Acessórios
        nav.navegacao-listas(aria-label="Outras áreas")
          a(href='/equipamentos') Equipamentos
          a(href='/veiculos') Veículos
          a(href='/clientes') Clientes
      header.cabecalho
        h1 Lista de Acessórios
        .acoes-cabecalho
          a.botao-adicionar(href="/adicionar?tipo=Acessório") Adicionar acessório

      - var filtrosAtuais = filtros || {}
      - var tiposAcessorioLista = tiposAcessorio && tiposAcessorio.length ? tiposAcessorio : ['Bloqueador', 'Leitor', 'Chaveiro']
      - var modelosLista = modelos && modelos.length ? modelos : ['Relé de Bloqueio', 'Ibutton']

      form.filtros-lista(action='/acessorios' method='get')
        .campo-busca
          label(for='busca') Buscar
          input#busca(type='search' name='busca' value=filtrosAtuais.busca placeholder='Tipo, modelo ou status')
        button.alternador-filtros(type='button' aria-expanded='false' aria-controls='filtros-acessorios') Filtrar
        .painel-filtros#filtros-acessorios(hidden)
          strong Opções de filtragem
          label(for='tipoAcessorio') Tipo de acessório
          select#tipoAcessorio(name='tipoAcessorio')
            option(value='') Todos
            each tipoAcessorio in tiposAcessorioLista
              option(value=tipoAcessorio selected=filtrosAtuais.tipoAcessorio === tipoAcessorio)= tipoAcessorio
          label(for='modelo') Modelo
          select#modelo(name='modelo')
            option(value='') Todos
            each modelo in modelosLista
              option(value=modelo selected=filtrosAtuais.modelo === modelo)= modelo
          label(for='status') Status
          select#status(name='status')
            option(value='') Todos
            option(value='Locado' selected=filtrosAtuais.status === 'Locado') Locado
            option(value='Disponível' selected=filtrosAtuais.status === 'Disponível') Disponível
            option(value='Em Manutenção' selected=filtrosAtuais.status === 'Em Manutenção') Em Manutenção
          .acoes-filtros
            button.botao(type='submit') Aplicar filtros
            a.limpar-filtros(href='/acessorios') Limpar

      main.conteiner-tabela
        table
          thead
            tr
              th Tipo
              th Modelo
              th Status
              th ID
              th Ações
          tbody
            if acessorios && acessorios.length > 0
              each item in acessorios
                tr
                  td= item.tipoAcessorio || "Não informado"
                  td= item.modelo || "Não informado"
                  td
                    - var classeStatus = item.status === 'Locado' ? 'status-locado' : item.status === 'Disponível' ? 'status-disponivel' : item.status === 'Em Manutenção' ? 'status-manutencao' : 'status-desconhecido'
                    span.distintivo-status(class=classeStatus)= item.status || "Não informado"
                  td= item.id || "Não informado"
                  td.acao-tabela
                    .botoes-acao
                      a.botao-editar(href='/objetos/' + item.id + '/editar?voltar=/acessorios' aria-label='Editar objeto' title='Editar objeto') &#9998;
                      form.formulario-remocao(action='/objetos/' + item.id + '/remover' method='post' onsubmit="return confirm('Remover este objeto?');")
                        button.botao-remover(type='submit' aria-label='Remover objeto' title='Remover objeto') &#128465;
            else
              tr
                td.estado-vazio(colspan="5") Nenhum acessório encontrado no estoque.

      script(src='/javascripts/list-filters.js')