extends layout

block content
  include menu.pug
  - var tecnologiaLista = tecnologiaOpcoes || ['2G', '4G']
  - var tipoClienteLista = tipoClienteOpcoes || ['Pessoa Física', 'Pessoa Jurídica']
  - var tipoClienteAtualNaLista = tipoClienteLista.indexOf(objeto.tipoCliente) >= 0
  - var modeloLista = modeloOpcoes || ['RST - OBDII', 'RST - Mini LC', 'RST MINI - LC', 'RST Mini', 'RST LCv5', 'RST One', 'RST MÓVEL RF', 'RST ISCA GPS LORA', 'RST Plus', 'RST Híbrido', 'RST Micro', 'RST - Globalstar', 'NT40', 'NONOS-N4']
  - var tecnologiaAtualNaLista = tecnologiaLista.indexOf(objeto.tecnologia) >= 0
  - var modeloAtualNaLista = modeloLista.indexOf(objeto.modelo) >= 0
  - var paginaAnterior = backUrl || '/inicio'
  - var veiculoAtual = objeto.veiculoId ? String(objeto.veiculoId) : ''
  - var equipamentoAtual = objeto.equipamentoId ? String(objeto.equipamentoId) : ''
  a.page-back(href=paginaAnterior) Voltar
  .container
    nav.breadcrumbs(aria-label="Navegação estrutural")
      a(href="/inicio") Início
      span(aria-hidden="true") /
      span Editar objeto
    header.header
      h1 Editar #{objeto.tipo}

    main.form-container
      if message
        p.error= message
      form.object-form(action='/objetos/' + objeto.id + '/editar' method='post')
        input(type='hidden' name='voltar' value=paginaAnterior)
        input(type='hidden' name='tipo' value=objeto.tipo)

        if objeto.tipo === 'Veículo'
          label(for='marca') Marca
          input#marca(type='text' name='marca' value=objeto.marca placeholder='Digite a marca' required)

          label(for='modelo') Modelo
          input#modelo(type='text' name='modelo' value=objeto.modelo placeholder='Digite o modelo' required)

          label(for='ano') Ano
          input#ano(type='number' name='ano' value=objeto.ano min='1900' max='2100' placeholder='Digite o ano' required)

          label(for='placa') Placa
          input#placa(type='text' name='placa' value=objeto.placa placeholder='Digite a placa' required)

          label(for='equipamentoId') Equipamento ligado
          select#equipamentoId(name='equipamentoId')
            option(value='' selected=!equipamentoAtual) Nenhum equipamento ligado
            each equipamento in (equipamentos || [])
              - var equipamentoTooltip = equipamento.relacao ? 'Garantia: ' + (equipamento.relacao.garantia || 'Não informada') + ' | Instalação: ' + (equipamento.relacao.dataInstalacao || 'Não informada') + ' | Retirada: ' + (equipamento.relacao.dataRetirada || 'Não informada') : 'Sem relação cadastrada'
              option(value=equipamento.id selected=String(equipamento.id) === equipamentoAtual title=equipamentoTooltip data-tooltip=equipamentoTooltip data-garantia=equipamento.relacao && equipamento.relacao.garantia data-data-instalacao=equipamento.relacao && equipamento.relacao.dataInstalacao data-data-retirada=equipamento.relacao && equipamento.relacao.dataRetirada)= equipamento.numeroSerie || 'Sem número de série'
          .relation-details(data-relation-details-for='equipamentoId' hidden)
            label(for='garantiaVeiculo') Garantia
            input#garantiaVeiculo(type='text' name='garantia' value=objeto.relacao && objeto.relacao.garantia placeholder='Ex.: 12 meses')
            label(for='dataInstalacaoVeiculo') Data de instalação
            input#dataInstalacaoVeiculo(type='date' name='dataInstalacao' value=objeto.relacao && objeto.relacao.dataInstalacao)
            label(for='dataRetiradaVeiculo') Data de retirada
            input#dataRetiradaVeiculo(type='date' name='dataRetirada' value=objeto.relacao && objeto.relacao.dataRetirada)

        if objeto.tipo === 'Equipamento'
          label(for='numeroSerie') Número de Série
          input#numeroSerie(type='text' name='numeroSerie' value=objeto.numeroSerie placeholder='Digite o número de série' required)

          label(for='tecnologia') Tecnologia
          select#tecnologia(name='tecnologia' required)
            option(value='') Selecione a tecnologia
            each tecnologia in tecnologiaLista
              option(value=tecnologia selected=tecnologia === objeto.tecnologia)= tecnologia
            if !tecnologiaAtualNaLista && objeto.tecnologia
              option(value=objeto.tecnologia selected=true)= objeto.tecnologia
            option(value='__nova_entrada__') Adicionar nova entrada
          input#novaTecnologia(type='text' placeholder='Digite a nova tecnologia' hidden)

          label(for='modelo') Modelo
          select#modelo(name='modelo' required)
            option(value='') Selecione o modelo
            each modelo in modeloLista
              option(value=modelo selected=modelo === objeto.modelo)= modelo
            if !modeloAtualNaLista && objeto.modelo
              option(value=objeto.modelo selected=true)= objeto.modelo
            option(value='__nova_entrada__') Adicionar nova entrada
          input#novoModelo(type='text' placeholder='Digite o novo modelo' hidden)

          label(for='anoAquisicao') Ano de Aquisição
          input#anoAquisicao(type='number' name='anoAquisicao' value=objeto.anoAquisicao min='1900' max='2100' placeholder='Digite o ano' required)

          label(for='status') Status
          select#status(name='status' required)
            each status in statusOpcoes
              option(value=status selected=status === objeto.status)= status

          label(for='veiculoId') Veículo ligado
          select#veiculoId(name='veiculoId')
            option(value='') Nenhum veículo
            each veiculo in (veiculos || [])
              - var veiculoTooltip = veiculo.relacao ? 'Garantia: ' + (veiculo.relacao.garantia || 'Não informada') + ' | Instalação: ' + (veiculo.relacao.dataInstalacao || 'Não informada') + ' | Retirada: ' + (veiculo.relacao.dataRetirada || 'Não informada') : 'Sem relação cadastrada'
              option(value=veiculo.id selected=String(veiculo.id) === veiculoAtual title=veiculoTooltip data-tooltip=veiculoTooltip data-garantia=veiculo.relacao && veiculo.relacao.garantia data-data-instalacao=veiculo.relacao && veiculo.relacao.dataInstalacao data-data-retirada=veiculo.relacao && veiculo.relacao.dataRetirada)= (veiculo.placa || 'Sem placa') + ' - ' + (veiculo.marca || '') + ' ' + (veiculo.modelo || '')
          .relation-details(data-relation-details-for='veiculoId' hidden)
            label(for='garantiaEquipamento') Garantia
            input#garantiaEquipamento(type='text' name='garantia' value=objeto.relacao && objeto.relacao.garantia placeholder='Ex.: 12 meses')
            label(for='dataInstalacaoEquipamento') Data de instalação
            input#dataInstalacaoEquipamento(type='date' name='dataInstalacao' value=objeto.relacao && objeto.relacao.dataInstalacao)
            label(for='dataRetiradaEquipamento') Data de retirada
            input#dataRetiradaEquipamento(type='date' name='dataRetirada' value=objeto.relacao && objeto.relacao.dataRetirada)

        if objeto.tipo === 'Acessório'
          label(for='tipoAcessorio') Tipo
          input#tipoAcessorio(type='text' name='tipoAcessorio' value=objeto.tipoAcessorio placeholder='Digite o tipo' required)

          label(for='modelo') Modelo
          input#modelo(type='text' name='modelo' value=objeto.modelo placeholder='Digite o modelo' required)

          label(for='status') Status
          select#status(name='status' required)
            each status in statusOpcoes
              option(value=status selected=status === objeto.status)= status

        if objeto.tipo === 'Cliente'
          label(for='nome') Nome
          input#nome(type='text' name='nome' value=objeto.nome placeholder='Digite o nome' required)

          label(for='fone') Fone
          input#fone(type='tel' name='fone' value=objeto.fone placeholder='Digite o telefone' required)

          label(for='tipoCliente') Tipo de Cliente
          select#tipoCliente(name='tipoCliente' required)
            option(value='') Selecione o tipo de cliente
            each tipoCliente in tipoClienteLista
              option(value=tipoCliente selected=tipoCliente === objeto.tipoCliente)= tipoCliente
            if !tipoClienteAtualNaLista && objeto.tipoCliente
              option(value=objeto.tipoCliente selected=true)= objeto.tipoCliente
            option(value='__nova_entrada__') Adicionar nova entrada
          input#novoTipoCliente(type='text' placeholder='Digite o novo tipo de cliente' hidden)

          label(for='cpfCnpj') CPF/CNPJ
          input#cpfCnpj(type='text' name='cpfCnpj' value=objeto.cpfCnpj placeholder='Digite o CPF ou CNPJ' required)

        .form-actions
          button.btn(type='submit') Salvar alterações
          a.cancel(href=paginaAnterior) Cancelar

    if objeto.tipo === 'Equipamento'
      script.
        (function () {
          var form = document.querySelector('.object-form');
          var entries = [
            {
              select: document.getElementById('tecnologia'),
              input: document.getElementById('novaTecnologia')
            },
            {
              select: document.getElementById('modelo'),
              input: document.getElementById('novoModelo')
            }
          ];

          entries.forEach(function (entry) {
            entry.select.addEventListener('change', function () {
              var isNewEntry = entry.select.value === '__nova_entrada__';
              entry.input.hidden = !isNewEntry;
              entry.input.disabled = !isNewEntry;
              entry.input.required = isNewEntry;
              if (!isNewEntry) {
                entry.input.value = '';
              }
            });
          });

          form.addEventListener('submit', function (event) {
            entries.forEach(function (entry) {
              if (entry.select.value !== '__nova_entrada__') {
                return;
              }

              var customValue = entry.input.value.trim();
              if (!customValue) {
                event.preventDefault();
                entry.input.focus();
                return;
              }

              var option = document.createElement('option');
              option.value = customValue;
              option.textContent = customValue;
              option.selected = true;
              entry.select.appendChild(option);
            });
          });
        }());
    if objeto.tipo === 'Cliente'
      script.
        (function () {
         var form = document.querySelector('.object-form');
         var select = document.getElementById('tipoCliente');
         var input = document.getElementById('novoTipoCliente');

         function updateEntry() {
           var isNewEntry = select.value === '__nova_entrada__';
           input.hidden = !isNewEntry;
           input.disabled = !isNewEntry;
           input.required = isNewEntry;
           if (!isNewEntry) input.value = '';
         }

         select.addEventListener('change', updateEntry);
         form.addEventListener('submit', function (event) {
           if (select.value !== '__nova_entrada__') return;
           var value = input.value.trim();
           if (!value) {
             event.preventDefault();
             input.focus();
             return;
           }
           var option = document.createElement('option');
           option.value = value;
           option.textContent = value;
           option.selected = true;
           select.appendChild(option);
         });
         updateEntry();
        }());
    if objeto.tipo === 'Equipamento' || objeto.tipo === 'Veículo'
      script.
        (function () {
          function configurarRelacao(select) {
            if (!select) return;
            var detalhes = document.querySelector('[data-relation-details-for="' + select.id + '"]');
            if (!detalhes) return;
            var campos = detalhes.querySelectorAll('input');
            function atualizar() {
              var option = select.options[select.selectedIndex];
              var ligado = Boolean(select.value);
              detalhes.hidden = !ligado;
              campos.forEach(function (campo) {
                campo.disabled = !ligado;
              });
              if (option && option.dataset.garantia !== undefined) {
                campos[0].value = option.dataset.garantia || '';
                campos[1].value = option.dataset.dataInstalacao || '';
                campos[2].value = option.dataset.dataRetirada || '';
              }
            }
            select.addEventListener('change', atualizar);
            atualizar();
            var tooltip = document.createElement('span');
            tooltip.className = 'relation-tooltip';
            tooltip.hidden = true;
            document.body.appendChild(tooltip);
            function mostrarTooltip(event) {
              var option = event.target.tagName === 'OPTION' ? event.target : select.options[select.selectedIndex];
              if (!option || !option.dataset.tooltip || !select.value) return;
              tooltip.textContent = option.dataset.tooltip;
              var rect = select.getBoundingClientRect();
              tooltip.style.left = rect.left + 'px';
              tooltip.style.top = (rect.bottom + 8) + 'px';
              tooltip.hidden = false;
            }
            select.addEventListener('mouseover', mostrarTooltip);
            select.addEventListener('focus', mostrarTooltip);
            select.addEventListener('mouseleave', function () { tooltip.hidden = true; });
            select.addEventListener('blur', function () { tooltip.hidden = true; });
          }
          configurarRelacao(document.getElementById('equipamentoId'));
          configurarRelacao(document.getElementById('veiculoId'));
        }());
